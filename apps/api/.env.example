# Local development only. Copy to .env and replace each secret with a random value of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORT=8080
DATABASE_URL=postgres://sari:sari@127.0.0.1:55433/sari_dev
JWT_SECRET=replace-with-a-random-value-of-32-characters
PROXY_SIGNING_SECRET=replace-with-a-random-value-of-32-characters
CLEANUP_SECRET=replace-with-a-random-value-of-32-characters
IP_HASH_SALT=replace-with-a-random-value-of-32-characters
SITE_ORIGIN=http://localhost:5173
