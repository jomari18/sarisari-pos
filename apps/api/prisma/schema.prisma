// SariSari POS data model (spec section 5). Money columns are integer centavos.
// Deleting a Store cascades to everything it owns. PostgreSQL checks NO ACTION links while the
// cascade is still running, so links inside a store either cascade (rows that live and die with
// their parent) or set null (optional links). The app never deletes users, categories, products
// or suki; it archives or deactivates them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  BANTAY
}

enum SecretKind {
  PASSWORD
  PIN
}

enum SaleSource {
  ONLINE
  OFFLINE_SYNC
}

enum PaymentMethod {
  CASH
  GCASH
  UTANG
}

enum MovementReason {
  SALE
  RESTOCK
  COUNT
  SPOILAGE
  EXPIRED
  VOID
}

enum UtangKind {
  CHARGE
  PAYMENT
  ADJUSTMENT
  VOID
}

model Store {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  nextReceiptNo Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)

  users        User[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  sales        Sale[]
  movements    StockMovement[]
  utangEntries UtangEntry[]

  @@index([expiresAt])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  storeId        String     @db.Uuid
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role           Role
  username       String     @unique
  displayName    String
  secretHash     String
  secretKind     SecretKind
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?  @db.Timestamptz(3)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  sessions     Session[]
  sales        Sale[]          @relation("cashier")
  voids        Sale[]          @relation("voidedBy")
  movements    StockMovement[]
  utangEntries UtangEntry[]

  @@index([storeId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([familyId])
  @@index([userId])
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  storeId  String    @db.Uuid
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  archived Boolean   @default(false)
  products Product[]

  @@unique([storeId, name])
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @db.Uuid
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String   @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  brand         String?
  barcode       String?
  unit          String
  priceCentavos Int
  costCentavos  Int
  stock         Int
  reorderLevel  Int      @default(0)
  packSize      Int      @default(1)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  saleItems SaleItem[]
  movements StockMovement[]

  // PostgreSQL treats NULLs as distinct, so many products can have no barcode.
  @@unique([storeId, barcode])
  @@index([storeId, name])
}

model Customer {
  id                  String   @id @default(uuid()) @db.Uuid
  storeId             String   @db.Uuid
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  creditLimitCentavos Int      @default(0)
  balanceCentavos     Int      @default(0)
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  sales        Sale[]
  utangEntries UtangEntry[]

  @@index([storeId, name])
}

model Sale {
  /// Generated by the device, so a retried or re-synced sale is recorded once.
  id               String        @id @db.Uuid
  storeId          String        @db.Uuid
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId        String        @db.Uuid
  cashier          User          @relation("cashier", fields: [cashierId], references: [id], onDelete: Cascade)
  receiptNo        Int
  soldAt           DateTime      @db.Timestamptz(3)
  receivedAt       DateTime      @default(now()) @db.Timestamptz(3)
  source           SaleSource
  method           PaymentMethod
  totalCentavos    Int
  tenderedCentavos Int?
  changeCentavos   Int?
  gcashRef         String?
  customerId       String?       @db.Uuid
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  flags            String[]      @default([])
  reviewedAt       DateTime?     @db.Timestamptz(3)
  voidedAt         DateTime?     @db.Timestamptz(3)
  voidReason       String?
  voidedById       String?       @db.Uuid
  voidedBy         User?         @relation("voidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  items        SaleItem[]
  movements    StockMovement[]
  utangEntries UtangEntry[]

  @@unique([storeId, receiptNo])
  @@index([storeId, soldAt])
}

model SaleItem {
  id                String   @id @default(uuid()) @db.Uuid
  saleId            String   @db.Uuid
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Position on the receipt, from 0, in the order the items were rung up.
  line              Int      @default(0)
  /// Null for a custom item typed in by the bantay.
  productId         String?  @db.Uuid
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name              String
  quantity          Int
  unitPriceCentavos Int
  unitCostCentavos  Int?
  lineTotalCentavos Int

  @@index([saleId])
}

model StockMovement {
  id         String         @id @default(uuid()) @db.Uuid
  storeId    String         @db.Uuid
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String         @db.Uuid
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  change     Int
  reason     MovementReason
  saleId     String?        @db.Uuid
  sale       Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String?
  stockAfter Int
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([storeId, productId, createdAt])
}

model UtangEntry {
  /// Generated by the device for payments, so a retried payment is applied once.
  id             String         @id @default(uuid()) @db.Uuid
  storeId        String         @db.Uuid
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId     String         @db.Uuid
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind           UtangKind
  /// Charges are positive, payments negative.
  amountCentavos Int
  method         PaymentMethod?
  saleId         String?        @db.Uuid
  sale           Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           String?
  balanceAfter   Int
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@index([storeId, customerId, createdAt])
}

model DemoQuota {
  ipHash String
  /// Manila calendar date, YYYY-MM-DD.
  day    String
  count  Int    @default(0)

  @@id([ipHash, day])
}
